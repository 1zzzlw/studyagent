# LangSmith（按需填写）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=study-agent

# 聊天模型：只用于 Chat Completions / Agent
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# 向量模型：只用于 Embeddings，可与聊天模型来自不同供应商
# 腾讯云 TokenHub 文本向量示例：
EMBEDDING_MODEL=kinfra-text-embedding-0.6b
EMBEDDING_BASE_URL=https://tokenhub.tencentmaas.com/v1
EMBEDDING_API_KEY=
