# 复制为 .env 后填写。已有 .env 无需覆盖。
# 文字模型与向量模型分别使用 OpenAI 兼容接口。
LLM_MODEL=your-chat-model
LLM_API_KEY=your-chat-key
LLM_BASE_URL=

EMBEDDING_MODEL=your-embedding-model
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_BASE_URL=

# 可选：限制结构化结果输出长度。部分推理模型会把推理 Token 也计入上限。
LLM_MAX_TOKENS=4096
# 若接口明确支持，可配置 LLM_REASONING_EFFORT；默认不传。
# 百炼 GLM-5.3 建议起点：把上面的上限改为 16384，再添加
# LLM_REASONING_EFFORT=low
